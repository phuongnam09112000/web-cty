      {
        "id": "homeservices01",
        "type": "home-services",
        "hidden": false,
        "data": {
          "eyebrow": {
            "vi": "Chúng tôi cung cấp",
            "en": "We provide"
          },
          "heading": {
            "lead": {
              "vi": "Dịch vụ",
              "en": "Professional"
            },
            "emphasis": {
              "vi": "Chuyên nghiệp",
              "en": "Services"
            }
          },
          "allLink": {
            "label": {
              "vi": "Xem tất cả dịch vụ",
              "en": "View all services"
            },
            "href": "/services"
          },
          "items": [
            {
              "title": {
                "vi": "Tích hợp Hệ thống",
                "en": "System Integration"
              },
              "description": {
                "vi": "ISTT là một công ty hàng đầu trong lĩnh vực Tích hợp Hệ thống (SI), giúp các doanh nghiệp và tổ chức kết nối các nền tảng công nghệ khác nhau thành một hệ thống thống nhất, tối ưu hóa hiệu quả hoạt động, bảo mật và khả năng mở rộng.",
                "en": "ISTT is a leading company in the field of System Integration (SI), helping businesses and organizations connect different technology platforms into a unified system, optimizing operational efficiency, security, and scalability."
              },
              "href": "/integration",
              "image": {
                "src": "/img/background/sy.jpg"
              }
            },
            {
              "title": {
                "vi": "Phát triển Phần mềm",
                "en": "Software Development"
              },
              "description": {
                "vi": "Chuyên phát triển và tích hợp các giải pháp phần mềm tùy chỉnh phù hợp với nhu cầu đa dạng của khách hàng. Bằng cách tận dụng công nghệ tiên tiến, chúng tôi giúp doanh nghiệp nâng cao hiệu suất, giảm thiểu rủi ro và cắt giảm chi phí.",
                "en": "Specializes in developing and integrating custom software solutions that align with diverse client requirements. By leveraging advanced technologies, we help businesses achieve greater efficiency, minimize risks, and reduce costs."
              },
              "href": "/software",
              "image": {
                "src": "/img/background/software.jpg"
              }
            },
            {
              "title": {
                "vi": "Hỗ trợ Kỹ thuật",
                "en": "Technical Support"
              },
              "description": {
                "vi": "Dịch vụ hỗ trợ kỹ thuật 24/7 được thiết kế để đảm bảo độ tin cậy và thời gian hoạt động của hệ thống. Với đội ngũ hỗ trợ giàu kinh nghiệm và hiện diện chiến lược tại Việt Nam, chúng tôi cung cấp các giải pháp nhanh chóng và nhất quán.",
                "en": "We offers 24/7 technical support services designed to ensure system reliability and uptime. With a skilled support team and strategic on-site presence across Vietnam, we provide rapid issue resolution and consistent service quality."
              },
              "href": "/support",
              "image": {
                "src": "/img/background/support.jpg"
              }
            }
          ]
        }
      },
