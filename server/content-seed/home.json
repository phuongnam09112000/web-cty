      {
        "id": "homeabout01",
        "type": "home-about",
        "hidden": false,
        "data": {
          "image": {
            "src": "/img/background/istt.jpg"
          },
          "foundedLabel": {
            "vi": "Thành lập",
            "en": "Founded"
          },
          "foundedYear": "2001",
          "eyebrow": {
            "vi": "VỀ CHÚNG TÔI",
            "en": "About us"
          },
          "heading": {
            "lead": {
              "vi": "Dịch vụ Thông tin &",
              "en": "Information Services &"
            },
            "emphasis": {
              "vi": "Chuyển giao Công nghệ",
              "en": "Technology Transfer"
            }
          },
          "lead": {
            "vi": "Được thành lập vào năm 2001, ISTT đã phát triển thành một nhà cung cấp hàng đầu về giải pháp tích hợp CNTT và viễn thông tại Việt Nam. Với cách tiếp cận lấy khách hàng làm trung tâm, chúng tôi kết nối các đối tác toàn cầu và mang đến công nghệ tiên tiến để thúc đẩy doanh nghiệp và cộng đồng phát triển.",
            "en": "Founded in 2001, ISTT has grown into a leading provider of integrated ICT and telecommunication solutions in Vietnam. With a customer-centric approach, we connect global partners and deliver cutting-edge technology to empower businesses and communities throughout the country and region."
          },
          "stats": [
            {
              "value": "20+",
              "label": {
                "vi": "Năm kinh nghiệm",
                "en": "Years Active"
              }
            },
            {
              "value": "20+",
              "label": {
                "vi": "Đối tác",
                "en": "Partners"
              }
            }
          ],
          "cta": {
            "label": {
              "vi": "Tìm hiểu thêm về ISTT",
              "en": "More about ISTT"
            },
            "href": "/about"
          }
        }
